RETURNWITNESS_STRIPE_SECRET_KEY=sk_test_replace_me
RETURNWITNESS_APPROVAL_SECRET=replace_with_64_hex_chars
# META_HACK_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL_SAM=sam-3.1
META_MODEL_SPARK=muse-spark-1.3
META_MODEL_WONDER=muse-wonder-1.0
# Contributor-mode model variants (Meta may train on the content) are always refused; there is no override.
# RETURNWITNESS_PUBLIC_DEMO=1
# RETURNWITNESS_DEV_FALLBACK=1
# GEMINI_API_KEY=
# Open-weight second reader (Muse Spark Open). baseten | modal; unset = not run, labelled on the card.
# RETURNWITNESS_OPENWEIGHT_PROVIDER=baseten
# BASETEN_API_KEY=
# BASETEN_OPENWEIGHT_MODEL=meta-models/muse-spark-open-1026
# SAM 3.1 failover: open weights on my Modal app (modal/README.md). Off unless =modal.
# RETURNWITNESS_SAM_FAILOVER=modal
# MODAL_SAM_URL=
# MODAL_SAM_TOKEN=
# MODAL_SAM_MODEL=facebook/sam3.1
# RETURNWITNESS_SAM_TIMEOUT_MS=60000
# Label reader: Muse Glimmer on Fireworks serverless. Off unless =fireworks; the model id has no default.
# RETURNWITNESS_LABEL_READER=fireworks
# FIREWORKS_API_KEY=
# FIREWORKS_GLIMMER_MODEL=
# FIREWORKS_ACCOUNT_ID=
# FIREWORKS_GLIMMER_USD_PER_MTOK_IN=
